rules_version = '2';

// Dashboard freelance pribadi (docs/PLAN.md §4, model data docs/PLAN-KLIEN.md §3). Satu pengguna: pemilik.
// Deny-by-default: koleksi yang tidak disebut di bawah tertutup untuk semua.
// Setiap aturan di sini punya tes di tests/rules/.
service cloud.firestore {
  match /databases/{database}/documents {

    // UID akun Google pemilik. Harus sama dengan OWNER_UID di src/owner.ts
    // (npm run lint memeriksanya). Cara mengganti: lihat CLAUDE.md.
    function isOwner() {
      return request.auth != null && request.auth.uid == 'TpuzzJ0wKXPAeNXnyMhfLr8GJjC3';
    }

    // ---- Validator field ----

    function str(v, max) {
      return v is string && v.size() <= max;
    }
    function requiredStr(v, max) {
      return str(v, max) && v.trim().size() > 0;
    }
    // Integer rupiah, tidak negatif, atau null.
    function moneyOrNull(v) {
      return v == null || (v is int && v >= 0 && v <= 100000000000);
    }
    function positiveMoney(v) {
      return v is int && v > 0 && v <= 100000000000;
    }
    function countOrNull(v) {
      return v == null || (v is int && v >= 1 && v <= 1000);
    }
    // "YYYY-MM-DD" atau "".
    function dateOrEmpty(v) {
      return v == '' || (v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'));
    }
    // https saja, atau "".
    function urlOrEmpty(v) {
      return v == '' || (str(v, 1000) && v.matches('^https://[^ ]+$'));
    }
    // Kontak klien: link https, alamat email sebagai mailto:, atau "".
    function contactOrEmpty(v) {
      return urlOrEmpty(v) || (str(v, 320) && v.matches('^mailto:[^ @/]+@[^ @/]+[.][^ @/]+$'));
    }

    // createdAt dan updatedAt = serverTimestamp(). createdAt tidak berubah.
    function stampsOnCreate(d) {
      return d.createdAt == request.time && d.updatedAt == request.time;
    }
    function stampsOnUpdate(d) {
      return d.createdAt == resource.data.createdAt && d.updatedAt == request.time;
    }

    function phoneOrEmpty(v) {
      return str(v, 30) && v.matches('^[0-9+ ()-]*$');
    }
    // "YYYY-MM" atau "".
    function monthOrEmpty(v) {
      return v == '' || (v is string && v.matches('^[0-9]{4}-(0[1-9]|1[0-2])$'));
    }
    function listMax(v, max) {
      return v is list && v.size() <= max;
    }
    // Relasi: dokumen induk harus ada setelah tulis ini (existsAfter, supaya
    // klien dan proyek pertamanya bisa dibuat dalam satu batch).
    function ref(c, id) {
      return id is string && id.size() > 0 && id.size() <= 200
        && existsAfter(/databases/$(database)/documents/$(c)/$(id));
    }
    function refOrNull(c, id) {
      return id == null || ref(c, id);
    }

    // ---- services: jasa dan harga patokan ----

    function validService(d) {
      return d.keys().hasAll(['name', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['name', 'setup', 'setupNote', 'monthly', 'unit', 'dpPercent', 'extras',
                             'includes', 'active', 'createdAt', 'updatedAt'])
        && requiredStr(d.name, 200)
        && moneyOrNull(d.get('setup', null))
        && str(d.get('setupNote', ''), 200)
        && moneyOrNull(d.get('monthly', null))
        && str(d.get('unit', ''), 50)
        && d.get('dpPercent', 50) is int && d.get('dpPercent', 50) >= 0 && d.get('dpPercent', 50) <= 100
        && listMax(d.get('extras', []), 20)
        && str(d.get('includes', ''), 5000)
        && d.get('active', true) is bool;
    }

    match /services/{id} {
      allow read, delete: if isOwner();
      allow create: if isOwner() && validService(request.resource.data) && stampsOnCreate(request.resource.data);
      allow update: if isOwner() && validService(request.resource.data) && stampsOnUpdate(request.resource.data);
    }

    // ---- clients: siapa dan dari mana ----

    function validClient(d) {
      return d.keys().hasAll(['name', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['name', 'contact', 'phone', 'source', 'sourceNote', 'note', 'log',
                             'createdAt', 'updatedAt'])
        && requiredStr(d.name, 200)
        && contactOrEmpty(d.get('contact', ''))
        && phoneOrEmpty(d.get('phone', ''))
        && d.get('source', '') in ['', 'Threads', 'Instagram', 'WhatsApp', 'Email', 'Referral', 'Website', 'Lainnya']
        && str(d.get('sourceNote', ''), 200)
        && str(d.get('note', ''), 5000)
        && listMax(d.get('log', []), 200);
    }

    match /clients/{id} {
      allow read, delete: if isOwner();
      allow create: if isOwner() && validClient(request.resource.data) && stampsOnCreate(request.resource.data);
      allow update: if isOwner() && validClient(request.resource.data) && stampsOnUpdate(request.resource.data);
    }

    // ---- projects: dari penawaran sampai live ----

    // Tahap yang wajib punya nextDate (NEXT_REQUIRED_STAGES di src/domain/types.ts).
    function needsNext(stage) {
      return stage in ['Baru', 'Menunggu kabar', 'Kirim harga', 'Demo', 'Nego', 'Deal', 'Dikerjakan', 'Revisi', 'On hold'];
    }

    function validProject(d) {
      return d.keys().hasAll(['clientId', 'stage', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['clientId', 'serviceId', 'name', 'stage', 'price', 'extras', 'qty', 'monthly',
                             'next', 'nextDate', 'due', 'link', 'dealAt', 'liveAt', 'note',
                             'createdAt', 'updatedAt'])
        && ref('clients', d.clientId)
        && refOrNull('services', d.get('serviceId', null))
        && str(d.get('name', ''), 200)
        && d.stage in ['Baru', 'Menunggu kabar', 'Kirim harga', 'Demo', 'Nego', 'Deal', 'Dikerjakan', 'Revisi',
                       'Live', 'Selesai', 'On hold', 'Batal']
        && moneyOrNull(d.get('price', null))
        && listMax(d.get('extras', []), 20)
        && countOrNull(d.get('qty', null))
        && moneyOrNull(d.get('monthly', null))
        && str(d.get('next', ''), 1000)
        && dateOrEmpty(d.get('nextDate', ''))
        && (!needsNext(d.stage) || d.get('nextDate', '') != '')
        && dateOrEmpty(d.get('due', ''))
        && urlOrEmpty(d.get('link', ''))
        && dateOrEmpty(d.get('dealAt', ''))
        && dateOrEmpty(d.get('liveAt', ''))
        && str(d.get('note', ''), 5000);
    }

    match /projects/{id} {
      allow read, delete: if isOwner();
      allow create: if isOwner() && validProject(request.resource.data) && stampsOnCreate(request.resource.data);
      allow update: if isOwner() && validProject(request.resource.data) && stampsOnUpdate(request.resource.data);
    }

    // ---- payments ----

    function validPayment(d) {
      return d.keys().hasAll(['clientId', 'type', 'amount', 'status', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['clientId', 'projectId', 'type', 'item', 'period', 'amount', 'due', 'status',
                             'paidAt', 'createdAt', 'updatedAt'])
        && ref('clients', d.clientId)
        && refOrNull('projects', d.get('projectId', null))
        && d.type in ['DP', 'Pelunasan', 'Setup', 'Langganan', 'Lainnya']
        && str(d.get('item', ''), 200)
        && monthOrEmpty(d.get('period', ''))
        && positiveMoney(d.amount)
        && dateOrEmpty(d.get('due', ''))
        && d.status in ['Belum', 'Lunas']
        && dateOrEmpty(d.get('paidAt', ''));
    }

    match /payments/{id} {
      allow read, delete: if isOwner();
      allow create: if isOwner() && validPayment(request.resource.data) && stampsOnCreate(request.resource.data);
      allow update: if isOwner() && validPayment(request.resource.data) && stampsOnUpdate(request.resource.data);
    }

    // ---- assets ----

    function validAsset(d) {
      return d.keys().hasAll(['item', 'kind', 'createdAt', 'updatedAt'])
        && d.keys().hasOnly(['clientId', 'projectId', 'item', 'kind', 'provider', 'cost', 'renewal', 'note',
                             'createdAt', 'updatedAt'])
        && refOrNull('clients', d.get('clientId', null))
        && refOrNull('projects', d.get('projectId', null))
        && requiredStr(d.item, 200)
        && d.kind in ['Domain', 'Hosting', 'Firebase', 'Cloudflare', 'Lainnya']
        && str(d.get('provider', ''), 200)
        && moneyOrNull(d.get('cost', null))
        && dateOrEmpty(d.get('renewal', ''))
        && str(d.get('note', ''), 5000);
    }

    match /assets/{id} {
      allow read, delete: if isOwner();
      allow create: if isOwner() && validAsset(request.resource.data) && stampsOnCreate(request.resource.data);
      allow update: if isOwner() && validAsset(request.resource.data) && stampsOnUpdate(request.resource.data);
    }
  }
}
