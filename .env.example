# Salin ke .env.local lalu isi dari Firebase console > Project settings > Web app.
# Kalau VITE_FIREBASE_PROJECT_ID kosong, aplikasi memakai emulator (project demo-freelance).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
